PORT=3000
AUTH_TOKEN=change-me
DB_PATH=./data/meinhelfer.db
LLM_BASE_URL=https://<llm-base-url>
LLM_API_KEY=change-me
LLM_MODEL=gemini/gemini-3.5-flash-lite
AGENT_CLARIFICATION_BUDGET=2
MAX_TOOL_ITERATIONS=6
LLM_MAX_TOKENS=2000
LLM_REASONING_EFFORT=minimal
# Lokaler Latenz-Fallback (optional): erste fertige Antwort gewinnt, hält Antwortzeit < 8 s
# LLM_FALLBACK_BASE_URL=http://<host>:11439/v1
# LLM_FALLBACK_MODEL=/models/gemma-4-E4B-it-Q4_0-ggml.gguf
# LLM_FALLBACK_AFTER_MS=7000
# Alexa-Endpoint-Validierung (/alexa): appId-Vergleich gegen ALEXA_SKILL_ID,
# optionale Signatur-Verifikation off/warn/enforce (Default off, prod enlist)
ALEXA_SKILL_ID=
ALEXA_VERIFY_MODE=off
ALEXA_DIRECTIVES_BASE=https://api.eu.amazonalexa.com
