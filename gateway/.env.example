# Gateway-Konfiguration: nach gateway/.env kopieren und befuellen.
# Pflichtwerte: ohne diese drei Zeilen startet der Prozess nicht.

# --- Pflicht ---
# Langes, zufaelliges Token; schuetzt Admin-UI und API.
AUTH_TOKEN=change-me-lange-zufaellige-zeichenkette
# OpenAI-kompatible Chat-Completions-Schnittstelle (mit Tool-Calling).
LLM_BASE_URL=http://llm.example.org:8000/v1
LLM_API_KEY=change-me
# Name des LLM-Modells am Endpunkt (muss Tool-Calling unterstuetzen).
LLM_MODEL=chat-fast

# --- Optional (Defaults in Klammern) ---
PORT=3000                          # Gateway-Port im Container (3000)
DB_PATH=./data/meinhelfer.db       # SQLite-Datei (./data/meinhelfer.db)
LLM_MAX_TOKENS=2000                # Ausgabe-Budget (2000)
LLM_REASONING_EFFORT=              # z. B. low/medium/high, falls Unterstuetzt
LLM_TOOL_DEADLINE_MS=9000          # Tool-Runden-Budget (9000)
MAX_TOOL_ITERATIONS=6              # max. Tool-Iterationen (6)
AGENT_CLARIFICATION_BUDGET=2       # max. Rueckfragen des Agenten (2)
LLM_KEEPALIVE_MS=120000            # Modell warm halten (120000; 0 = aus)

# --- Nur Compose-Host-Mapping (der Code liest PORT) ---
# GATEWAY_PORT=8331
